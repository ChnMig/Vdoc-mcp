{
  "name": "@vdoc/mcp",
  "version": "0.4.0-beta.5",
  "description": "Vdoc MCP stdio adapter for document management.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vdoc-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "examples",
    "assets",
    "scripts/install-channel.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "release:package": "bash scripts/package-release.sh",
    "test": "npm run build && node --test test/*.test.mjs",
    "verify:live-audit": "npm run build && node scripts/live-stdio-audit.mjs",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
