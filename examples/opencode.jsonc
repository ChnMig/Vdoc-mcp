{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "vdoc": {
      "type": "local",
      "command": ["npx", "-y", "@vdoc/mcp"],
      "environment": {
        "VDOC_BASE_URL": "https://your-vdoc.example.com",
        "VDOC_MCP_TOKEN": "REPLACE_WITH_LOCAL_VDOC_MCP_TOKEN"
      }
    }
  }
}
