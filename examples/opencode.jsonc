{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "vdoc": {
      "type": "local",
      "command": ["npx", "--yes", "@chnmig/vdoc-mcp@latest"],
      "environment": {
        "VDOC_BASE_URL": "https://your-vdoc.example.com",
        "VDOC_MCP_TOKEN": "REPLACE_WITH_LOCAL_VDOC_MCP_TOKEN"
      }
    }
  }
}
