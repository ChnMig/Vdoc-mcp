    {
      "name": "commit_changes",
      "scopes_any": [
        "api:draft",
        "doc:draft"
      ],
      "required": [
        "project_id",
        "branch_id",
        "expected_head_commit_id",
        "expected_generation",
        "idempotency_key",
        "changes"
      ],
      "optional": [
        "message"
      ],
      "argument_schemas": {
        "expected_generation": {
          "type": "integer",
          "minimum": 0
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation"
            ],
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "upsert",
                  "delete"
                ]
              },
              "document_id": {
                "type": "string"
              },
              "relative_path": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "document_type": {
                "type": "integer",
                "enum": [
                  1,
                  2,
                  3
                ]
              },
              "content": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "oneOf": [
              {
                "properties": {
                  "operation": {
                    "const": "upsert"
                  }
                },
                "required": [
                  "relative_path",
                  "name",
                  "document_type",
                  "content"
                ]
              },
              {
                "properties": {
                  "operation": {
                    "const": "delete"
                  }
                },
                "required": [
                  "document_id"
                ]
              }
            ]
          }
        }
      }
    },
